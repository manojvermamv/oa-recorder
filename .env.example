# OpenAlgo API key (OpenAlgo web UI -> API Key). Easiest: run `oar setup`, it fills this in.
OAR_API_KEY=

# Docker only: OpenAlgo's Docker network and container address
OPENALGO_NETWORK=openalgo_default
# OAR_HOST=http://openalgo-web:5000
# OAR_WS_URL=ws://openalgo-web:8765
# Host folder for the recorded data
# OAR_DATA_PATH=./data
